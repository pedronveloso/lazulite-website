      "css": ".ds-faq{background:var(--surface,#131B25);border:1px solid var(--hairline,#223040);border-radius:6px;color:var(--text-secondary,#A3B2C2);font-family:Sora, system-ui, -apple-system, \"Segoe UI\", sans-serif;transition:border-color .15s ease;}.ds-faq:hover,.ds-faq[open]{border-color:var(--accent,#3E8FD8);}.ds-question{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 24px;list-style:none;cursor:pointer;font-size:15px;font-weight:600;line-height:1.4;color:var(--text-primary,#E4EAF0);}.ds-question::-webkit-details-marker{display:none;}.ds-question::after{content:\"+\";color:var(--accent,#3E8FD8);font:400 18px ui-monospace,monospace;transition:transform .2s ease;}.ds-faq[open] .ds-question::after{transform:rotate(45deg);}.ds-question:focus-visible{outline:2px solid var(--focus-ring,#6FB2E8);outline-offset:3px;border-radius:4px;}.ds-answer{padding:0 24px 24px;font-size:15px;line-height:1.75;max-width:65ch;}@media(prefers-reduced-motion:reduce){.ds-faq,.ds-question::after{transition-duration:.01ms;}}@media(prefers-reduced-motion:reduce){.ds-button,.ds-trigger{transition-duration:.01ms;}}"
    }
