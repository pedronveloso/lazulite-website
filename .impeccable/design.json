  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "Primary action; runtime roles select dark or light fill, on-accent text, and independent hover border.",
      "html": "<button class=\"ds-button ds-primary\">Get Lazulite</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 24px;border:1px solid var(--accent,#3E8FD8);border-radius:4px;font:600 15px/1.25 Sora, system-ui, -apple-system, \"Segoe UI\", sans-serif;cursor:pointer;text-decoration:none;transition:background-color .15s ease,color .15s ease,border-color .15s ease;}.ds-button:focus-visible{outline:2px solid var(--focus-ring,#6FB2E8);outline-offset:3px;border-radius:4px;}.ds-primary{background:var(--accent,#3E8FD8);color:var(--on-accent,#0B1017);}.ds-primary:hover{background:var(--button-hover,#6FB2E8);border-color:var(--button-hover-border,#6FB2E8);color:var(--on-accent,#0B1017);}@media(prefers-reduced-motion:reduce){.ds-button,.ds-trigger{transition-duration:.01ms;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "Transparent hairline action with an accent border on hover; runtime roles also support the light variant.",
      "html": "<button class=\"ds-button ds-secondary\">Read the FAQ</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 24px;border:1px solid var(--accent,#3E8FD8);border-radius:4px;font:600 15px/1.25 Sora, system-ui, -apple-system, \"Segoe UI\", sans-serif;cursor:pointer;text-decoration:none;transition:background-color .15s ease,color .15s ease,border-color .15s ease;}.ds-button:focus-visible{outline:2px solid var(--focus-ring,#6FB2E8);outline-offset:3px;border-radius:4px;}.ds-secondary{background:transparent;color:var(--text-primary,#E4EAF0);border-color:var(--hairline,#223040);}.ds-secondary:hover{border-color:var(--accent,#3E8FD8);color:var(--link-hover,#6FB2E8);}@media(prefers-reduced-motion:reduce){.ds-button,.ds-trigger{transition-duration:.01ms;}}"
    },
    {
      "name": "Appearance Selector",
      "kind": "nav",
      "refersTo": "header-selector-dark",
      "description": "Native disclosure and radio-group primitive shared visually with language. The site adds persistence, dismissal, and one-open-menu behavior. Its decorative inline half-filled circle identifies appearance without an icon font. Invisible translated sizing labels keep its width stable. On the live page, the inline core reserves space before paint and deferred wiring reveals the control when ready.",
      "html": "<nav class=\"ds-selector\" aria-label=\"Appearance\"><details class=\"ds-menu\"><summary class=\"ds-trigger\"><svg class=\"ds-selector-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3a9 9 0 0 1 0 18Z\" fill=\"currentColor\" stroke=\"none\"/></svg><span class=\"ds-selector-label\"><span>System</span><span class=\"ds-label-sizer\" aria-hidden=\"true\">System</span><span class=\"ds-label-sizer\" aria-hidden=\"true\">Light</span><span class=\"ds-label-sizer\" aria-hidden=\"true\">Dark</span></span> <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" aria-hidden=\"true\"><path d=\"m3 4.5 3 3 3-3\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></summary><fieldset class=\"ds-popover\"><legend class=\"ds-hidden\">Appearance</legend><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-theme\" value=\"system\" checked>System</label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-theme\" value=\"light\">Light</label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-theme\" value=\"dark\">Dark</label></fieldset></details></nav>",
      "css": ".ds-selector{font-family:Sora, system-ui, -apple-system, \"Segoe UI\", sans-serif;}.ds-menu{position:relative;display:inline-block;}.ds-trigger{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:.35rem .75rem;background:transparent;border:1px solid var(--hairline,#223040);border-radius:4px;color:var(--text-secondary,#A3B2C2);font-size:12px;font-weight:600;letter-spacing:.08em;cursor:pointer;list-style:none;transition:border-color .15s ease,color .15s ease;}.ds-trigger::-webkit-details-marker{display:none;}.ds-trigger:hover,.ds-menu[open] .ds-trigger{border-color:var(--accent,#3E8FD8);color:var(--text-primary,#E4EAF0);}.ds-popover{position:absolute;right:0;top:calc(100% + 8px);z-index:110;display:grid;gap:2px;min-width:12rem;margin:0;padding:4px;background:var(--surface-raised,#1A2532);border:1px solid var(--hairline,#223040);border-radius:6px;}.ds-choice{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 12px;border-radius:4px;color:var(--text-secondary,#A3B2C2);font-size:14px;cursor:pointer;}.ds-choice input{margin:0;width:1rem;height:1rem;accent-color:var(--accent,#3E8FD8);}.ds-choice:hover,.ds-choice:focus-within{background:var(--surface,#131B25);color:var(--text-primary,#E4EAF0);}.ds-choice:has(input:checked){background:var(--surface,#131B25);color:var(--accent,#3E8FD8);}.ds-trigger:focus-visible,.ds-choice input:focus-visible{outline:2px solid var(--focus-ring,#6FB2E8);outline-offset:3px;border-radius:4px;}.ds-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;}@media(prefers-reduced-motion:reduce){.ds-button,.ds-trigger{transition-duration:.01ms;}}.ds-selector-icon{display:block;flex-shrink:0;}.ds-selector-label{flex:1;display:inline-grid;}.ds-selector-label>span{grid-area:1/1;}.ds-label-sizer{visibility:hidden;}"
    },
