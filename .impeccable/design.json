  "narrative": {
    "northStar": "The Instrument Panel",
    "overview": "The website carries the app's identity onto a page. Lazulite is a measurement tool: quiet tonal panels, hairline rules, a single lapis-blue accent, and numbers that stay put. Mineral navy gives the dark theme its ground; the light theme uses cool, pale neutrals with the same restrained structure. Nothing decorates; everything informs.\n\nThe audience is informed, skeptical, and evidence-minded, so the page earns trust through precision and plain statements. The Android app defines the shared palettes and typography in `Color.kt`, `Theme.kt`, and `Typography.kt`; mirror changes here after the app. Website-specific interaction roles live in `themes/lazulite/assets/sass/utils/_variables.scss`. Product intent, terminology, and voice belong in `PRODUCT.md` and the shared Android product reference.",
    "keyCharacteristics": [
      "App-matched dark and light palettes; tonal surfaces and 1px hairlines.",
      "One lapis accent; gold, amber, and muted red only support labeled signal tiers.",
      "Sora, sentence case, tight corners, and tabular measured values.",
      "Flat surfaces without shadows, gradients, glows, or decorative motion.",
      "Existing dark app captures remain authentic in both website themes."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Lapis is the only brand accent. Gold and amber belong to the signal ramp; do not reintroduce amber as a brand color or teal as a data color.",
        "section": "colors"
      },
      {
        "name": "The Semantic Role Rule",
        "body": "Use the runtime role for the job. Page ground, text on accent, interactive text, hover, focus, and media ground remain distinct even when dark-theme values coincide.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Headings use sentence case. Uppercase belongs to the wordmark and section-label treatment, including reading-page label-style third-level headings. CJK hierarchy must remain clear without case changes.",
        "section": "typography"
      },
      {
        "name": "The No-Shadow Rule",
        "body": "If something needs to stand out, change its tone or border. Do not add a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use runtime semantic color properties in components and keep both palette maps aligned with the app.",
      "**Do** keep page ground, on-accent text, interactive text, hover, focus, and media ground as separate roles.",
      "**Do** keep text contrast at 4.5:1 or better and preserve the 2px theme-specific focus ring.",
      "**Do** verify English and Japanese at desktop and mobile widths in both themes.",
      "**Do** use tabular figures for measurements, versions, and dates.",
      "**Do** preserve native radio keyboard behavior and translated System, Light, and Dark choices in all five languages.",
      "**Do** preserve authentic dark app media and its fixed dark video background in both themes."
    ],
    "donts": [
      "**Don't** use amber, gold, or teal as additional brand accents.",
      "**Don't** add shadows, gradients, glows, glass, or pill shapes.",
      "**Don't** set ordinary headings in all caps or condensed faces, or reintroduce Barlow Condensed, Epilogue, or Fira Mono.",
      "**Don't** use color as the only carrier of status.",
      "**Don't** add decorative motion; honor reduced-motion preferences.",
      "**Don't** hard-code component colors, add inline styles in content, or use color-named classes.",
      "**Don't** infer light-theme button text, focus, hover, or media colors from a dark-theme coincidence."
    ]
  }
}
