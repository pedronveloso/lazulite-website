      "html": "<section class=\"ds-panel\"><div class=\"ds-label\">Bluetooth transport</div><div class=\"ds-metric\"><span>Sample rate</span><span class=\"ds-value\">96 kHz</span></div></section>",
      "css": ".ds-panel{padding:24px;background:var(--surface,#131B25);border:1px solid var(--hairline,#223040);border-radius:6px;color:var(--text-secondary,#A3B2C2);font-family:Sora, system-ui, -apple-system, \"Segoe UI\", sans-serif;}.ds-label{font-size:11px;font-weight:600;line-height:1.45;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted,#7D8FA3);}.ds-metric{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:8px 0;font-size:14px;}.ds-value{color:var(--text-primary,#E4EAF0);text-align:right;font-variant-numeric:tabular-nums;}@media(prefers-reduced-motion:reduce){.ds-button,.ds-trigger{transition-duration:.01ms;}}"
